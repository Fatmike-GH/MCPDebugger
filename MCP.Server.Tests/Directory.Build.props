<Project>
  <Import Project="../Directory.Build.props" />
  <Import Project="../Tests.props" />
  <PropertyGroup>
    <OutputPath>..\build\$(Configuration)\$(Platform)\MCP.Server.Tests\</OutputPath>
    <BaseIntermediateOutputPath>..\build\$(Configuration)\$(Platform)\obj\MCP.Server.Tests\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>..\build\$(Configuration)\$(Platform)\ext\MCP.Server.Tests\</MSBuildProjectExtensionsPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
</Project>
