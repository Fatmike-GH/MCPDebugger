  <!-- Google Test comes from vcpkg (manifest vcpkg.json next to this file). The integration of the vcpkg copy
       that ships with Visual Studio is imported here, so the build needs no machine-wide "vcpkg integrate". -->
  <PropertyGroup Label="Vcpkg">
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <VcpkgUseStatic>true</VcpkgUseStatic>
    <VcpkgUseMD>true</VcpkgUseMD>
    <VcpkgInstalledDir>$(BuildRootFolder)ext\MCP.Debugger.NativeTests\vcpkg_installed\</VcpkgInstalledDir>
    <!-- vcpkg builds Google Test from source below its build-tree folder. The default sits deep inside the
         install folder and exceeds the path length the compiler accepts; this one is short. -->
    <VcpkgAdditionalInstallOptions>"--x-buildtrees-root=$(BuildRootFolder)obj\vcpkg" --clean-buildtrees-after-build</VcpkgAdditionalInstallOptions>
    <!-- Static libraries only: there is no DLL to copy next to the test binary. -->
    <VcpkgApplocalDeps>false</VcpkgApplocalDeps>
    <ImportBundledVcpkg Condition="'$(VcpkgPropsImported)' != 'true'">true</ImportBundledVcpkg>
  </PropertyGroup>
  <Import Project="$(VsInstallRoot)\VC\vcpkg\scripts\buildsystems\msbuild\vcpkg.props" Condition="'$(ImportBundledVcpkg)' == 'true'" />
